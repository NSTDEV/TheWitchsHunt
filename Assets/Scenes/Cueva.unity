    - target: {fileID: 5196447609868974185, guid: 3684dd7207e9286409e644d363742450, type: 3}
      propertyPath: textoNota
      value: "\u201C\xDAltima entrada\u201D\r\nMe ofrecieron trabajo en las minas,
        limpieza y comida\u2026\r\nSoy la \xFAnica mujer aqu\xED, no hay nadie m\xE1s???\r\nEscucho
        sus voces, las risas de los mineros, entre los t\xFAneles\u2026\r\nMe miran
        de forma rara\u2026 no deb\xED venir aqu\xED.\r\n\r\n\n\nClick izquierdo
        para salir"
      objectReference: {fileID: 0}
