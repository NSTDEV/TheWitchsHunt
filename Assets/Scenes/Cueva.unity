--- !u!1001 &1138477942
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 2073259348994296078, guid: 85843f474aae564429e74ca7ca84487f, type: 3}
      propertyPath: m_text
      value: "\u201CNo hay Luz\u201D\r\nEl cuerpo me duele\u2026 cada hueso, cada
        aliento\u2026\r\nLa piel arde como si el carb\xF3n se me hubiera pegado al
        alma.\r\nTomi ya no est\xE1. Su risa se apag\xF3 junto a la \xFAltima l\xE1mpara
        de la caba\xF1a\u2026\r\nNo hay luz. Solo ese murmullo en la oscuridad\u2026\r\nMe
        est\xE1 llamando\u2026\r\nPromete que el dolor terminar\xE1 si lo sigo\u2026\r\nLos
        mineros van a pagar. Alla abajo nadie podr\xE1 hacerme da\xF1o otra vez.\r\nNo
        puedo escapar, no quiero escapar\u2026\r\nSi esta sombra me reclama\u2026
        ll\xE9vame\u2026\r\nAl fin, dejar\xE9 de ser yo\u2026\r\n\nPresiona Espacio
        para salir\n"
      objectReference: {fileID: 0}
    - target: {fileID: 3590812397824771429, guid: 85843f474aae564429e74ca7ca84487f, type: 3}
      propertyPath: m_IsActive
