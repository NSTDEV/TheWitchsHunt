--- !u!1001 &1034026509
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 380280374}
    m_Modifications:
    - target: {fileID: 4781157048214760508, guid: 3684dd7207e9286409e644d363742450, type: 3}
      propertyPath: m_Name
      value: Nota (3)
      objectReference: {fileID: 0}
    - target: {fileID: 5196447609868974185, guid: 3684dd7207e9286409e644d363742450, type: 3}
      propertyPath: textoNota
      value: "\u201CNo hay Luz\u201D\r\nEl cuerpo me duele\u2026 cada hueso, cada
        aliento\u2026\r\nLa piel arde como si el carb\xF3n se me hubiera pegado al
        alma.\r\nTomi ya no est\xE1. Su risa se apag\xF3 junto a la \xFAltima l\xE1mpara
        de la caba\xF1a\u2026\r\nNo hay luz. Solo ese murmullo en la oscuridad\u2026\r\nMe
        est\xE1 llamando\u2026\r\nPromete que el dolor terminar\xE1 si lo sigo\u2026\r\nLos
        mineros van a pagar. Alla abajo nadie podr\xE1 hacerme da\xF1o otra vez.\r\nNo
        puedo escapar, no quiero escapar\u2026\r\nSi esta sombra me reclama\u2026
        ll\xE9vame\u2026\r\nAl fin, dejar\xE9 de ser yo\u2026\r\n\r\n\nClick izquierdo
        para salir"
      objectReference: {fileID: 0}
    - target: {fileID: 5374551432333275401, guid: 3684dd7207e9286409e644d363742450, type: 3}
      propertyPath: m_LocalScale.x
      value: 0.11596794
      objectReference: {fileID: 0}
